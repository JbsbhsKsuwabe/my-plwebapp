{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages && node scripts/fix-cloudflare-routes.mjs",
    "start": "next start",
    "deploy": "npm run build:cf && wrangler pages deploy .vercel/output/static",
    "lint": "eslint",
    "pages:build": "npx @cloudflare/next-on-pages && node scripts/fix-cloudflare-routes.mjs",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy:prod": "npm run pages:build && wrangler pages deploy --project-name tem-luz-ai",
    "verify": "node scripts/verify-home-route.mjs",
    "verify:local": "node scripts/verify-home-route.mjs http://localhost:3000"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.67.0"
  }
}
